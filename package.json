{
  "name": "khair-publications-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static website for Khair Publications, built with Eleventy.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "optimize-images": "node tools/optimize-images.js",
    "generate-assets": "python tools/generate-assets.py",
    "clean": "node tools/clean.js",
    "preview": "node tools/serve.js dist 8099",
    "validate": "node tools/validate-build.js",
    "check": "npm run build && npm run validate"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "browserslist": "^4.28.9",
    "lightningcss": "^1.28.2",
    "sharp": "^0.35.4"
  }
}
