<footer class="py-5 bg-dark-custom rounded-4 m-3 m-lg-4" data-aos="clip-bottom">
  <div class="container">
    <div class="row text-center text-md-start align-items-center">

      <div class="col-md-6 mb-4 mb-md-0 d-flex flex-column align-items-center align-items-md-start">
        <div class="content-title fw-bold text-yellow mb-3">{{ site.name }}</div>
        <p class="text-light-custom mb-3">{{ site.footer.tagline }}</p>
        <div class="d-flex gap-3 justify-content-center justify-content-md-start">
          <a href="{{ site.social.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Khair Publications on Facebook">
            <i class="fab fa-facebook-f social-icon text-light-custom" aria-hidden="true"></i>
          </a>
          <a href="{{ site.social.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="Khair Publications on LinkedIn">
            <i class="fab fa-linkedin-in social-icon text-light-custom" aria-hidden="true"></i>
          </a>
          <a href="{{ site.social.whatsapp }}" target="_blank" rel="noopener noreferrer" aria-label="Khair Publications on WhatsApp">
            <i class="fab fa-whatsapp social-icon social-icon--whatsapp" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <div class="col-md-6">
        <p class="text-light-custom mb-3">{{ site.footer.contactBlurb }}</p>

        <p class="text-light-custom fst-italic fs-5 mb-2 d-flex align-items-center justify-content-center justify-content-md-start">
          <i class="fas fa-envelope text-yellow me-2" aria-hidden="true"></i>
          <a href="mailto:{{ site.contact.email }}" class="text-light-custom text-decoration-none fw-semibold">
            {{ site.contact.email }}
          </a>
        </p>

        <p class="text-light-custom fst-italic fs-5 mb-0 d-flex align-items-center justify-content-center justify-content-md-start">
          <i class="fas fa-phone-alt text-yellow me-2" aria-hidden="true"></i>
          <a href="{{ site.contact.phoneHref }}" class="text-light-custom text-decoration-none fw-semibold">
            {{ site.contact.phoneDisplay }}
          </a>
        </p>
      </div>

    </div>

    <hr class="border-warning border-2 opacity-50 my-4">
    <p class="text-light-custom text-center small mb-0">
      &copy; {{ '' | year }} {{ site.name }}. All rights reserved.
    </p>
  </div>
</footer>
