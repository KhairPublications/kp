{# A circular-portrait person card, used by the team and editorial board pages. #}
{% macro personCard(person, options={}) %}
<div class="card card-custom h-100 p-4 text-center">
  {% image person.image, person.name, {
    sizes: "160px",
    className: "person-card__avatar rounded-circle mx-auto mb-3",
    widths: [300, 600]
  } %}
  <h3 class="card-title text-yellow h4">{{ person.name }}</h3>
  {% if person.role %}
  <p class="card-text"><strong>{{ person.role }}</strong>{% if person.affiliation %}<br>{{ person.affiliation }}{% endif %}</p>
  {% endif %}
  {% if person.title %}<p class="card-text">{{ person.title }}</p>{% endif %}
  {% if person.bio and options.showBio !== false %}<p class="card-text">{{ person.bio }}</p>{% endif %}
</div>
{% endmacro %}

{# A wide portrait card for leadership profiles. #}
{% macro profileCard(person) %}
<div class="card card-custom text-center p-4">
  {% image person.image, person.name, {
    sizes: "(max-width: 767px) 90vw, 640px",
    className: "profile-card__portrait card-img-top rounded mb-3"
  } %}
  <div class="card-body">
    <h3 class="card-title fw-bold text-yellow h4">{{ person.name }}</h3>
    {% if person.title %}<p class="card-text">{{ person.title }}</p>{% endif %}
    <p class="mb-0">{{ person.bio }}</p>
  </div>
</div>
{% endmacro %}
